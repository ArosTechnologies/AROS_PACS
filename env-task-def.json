      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgres://postgres:ubK!b1%3E=jC%3C2q?Ms@aros-core-db.ca74io886fcl.us-east-1.rds.amazonaws.com:5432/postgres"
        },
        {
          "name": "SECRET_KEY",
          "value": "django-insecure-dummy-key"
        },
        {
